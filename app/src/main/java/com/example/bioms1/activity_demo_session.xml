<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@android:color/white">


    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBarLayout"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:fitsSystemWindows="true"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/Tittle"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:background="@color/JGreen"
            android:paddingVertical="5dp"
            android:text="BioMS"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="40sp"
            android:textStyle="bold" />
    </com.google.android.material.appbar.AppBarLayout>


    <ScrollView
        android:id="@+id/scrollView2"
        android:layout_width="match_parent"
        android:layout_height="520dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/appBarLayout">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="475dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textView2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="How to Record Your Symptoms"
                android:textSize="20dp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />


            <androidx.cardview.widget.CardView
                android:id="@+id/graphCard"
                android:layout_width="350dp"
                android:layout_height="475dp"
                android:layout_marginTop="10dp"
                android:elevation="200dp"
                android:outlineAmbientShadowColor="@color/JGreen"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView2">

                <TextView
                    android:id="@+id/textView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Walking Speed and Endurance"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/textView15"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="Put your phone in your pocket and start walking. Keep walking for however long you can. After you are done, click the save button."
                    android:layout_marginTop="35dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Balance"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="70dp"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/textView16"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="Record a 40 - 60 second clip of yourself standing facing towards the camera. Make sure your full body is in view."
                    android:layout_marginTop="95dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView100"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Muscle Spacistity"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="130dp"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/textView17"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="Walk towards the camera making sure that your entire body is completely visible in all 20 seconds"
                    android:layout_marginTop="155dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView101"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sensory Axtia"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="190dp"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/textView18"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="Repeat the walking and balance tests with your eyes closed."
                    android:layout_marginTop="215dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView102"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dual Tast"
                    android:layout_marginLeft="10dp"
                    android:textStyle="bold"
                    android:layout_marginTop="240dp"
                    android:textSize="15dp" />

                <TextView
                    android:id="@+id/textView19"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="For this test choose one of the three options to do while walking:"
                    android:layout_marginTop="265dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView20"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="- Name the color of the rain bow backwards"
                    android:layout_marginTop="285dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView21"
                    android:layout_width="330dp"
                    android:layout_height="wrap_content"
                    android:text="- Count from 15 backwards"
                    android:layout_marginTop="305dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>

                <TextView
                    android:id="@+id/textView22"
                    android:layout_width="320dp"
                    android:layout_height="wrap_content"
                    android:text="- Say the alphabet backwards."
                    android:layout_marginTop="325dp"
                    android:layout_marginLeft="10dp"
                    android:textSize="10sp"/>


                  </androidx.cardview.widget.CardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

    <Button
        android:id="@+id/record_button"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:background="@color/JGreen"
        android:padding="10dp"
        android:text="Record"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.948"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView2" />

    <Button
        android:id="@+id/cancel_button"
        android:layout_width="100dp"
        android:layout_height="wrap_content"
        android:background="@color/red"
        android:padding="10dp"
        android:text="Cancel"
        android:textAlignment="center"
        android:textSize="20sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.051"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scrollView2" />


</androidx.constraintlayout.widget.ConstraintLayout>